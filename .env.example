# Optional lock for the public site. When set, the phone must enter this
# password before Pocketwall will talk to the firewall.
POCKETWALL_PASSWORD=

# Signs the unlock cookie. Use a long random string in production.
POCKETWALL_SECRET=

# Set to 1 only if this server can reach a private firewall address.
# On Vercel this stays unset: the hosted app can only call a public admin URL.
POCKETWALL_ALLOW_PRIVATE=
